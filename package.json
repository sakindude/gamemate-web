    "test:payout-flow:full": "npm run test:seed:payout-flow && npm run test:payout-flow",
    "test:seed:payout-blocked-flow": "node --env-file=.env.local scripts/seed-payout-blocked-flow.mjs",
    "test:payout-blocked-flow": "node --env-file=.env.local ./node_modules/@playwright/test/cli.js test tests/e2e/payout-blocked-flow.spec.ts",
