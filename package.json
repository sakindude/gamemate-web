    "test:ui-start-flow:full": "npm run test:seed:ui-start-flow && npm run test:ui-start-flow",
    "test:seed:ui-complete-flow": "node --env-file=.env.local scripts/seed-ui-complete-flow.mjs",
    "test:ui-complete-flow": "node --env-file=.env.local ./node_modules/@playwright/test/cli.js test tests/e2e/ui-complete-flow.spec.ts",
    "test:ui-complete-flow:full": "npm run test:seed:ui-complete-flow && npm run test:ui-complete-flow",
