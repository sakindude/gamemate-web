    "test:busy-seller:full": "npm run test:seed:busy-seller && npm run test:busy-seller",
    "test:seed:buyer-block": "node --env-file=.env.local scripts/seed-buyer-block.mjs",
    "test:buyer-block": "node --env-file=.env.local ./node_modules/@playwright/test/cli.js test tests/e2e/buyer-block.spec.ts",
    "test:buyer-block:full": "npm run test:seed:buyer-block && npm run test:buyer-block",
    "test:seed:accept-flow": "node --env-file=.env.local scripts/seed-accept-flow.mjs",
    "test:accept-flow": "node --env-file=.env.local ./node_modules/@playwright/test/cli.js test tests/e2e/accept-flow.spec.ts",
    "test:accept-flow:full": "npm run test:seed:accept-flow && npm run test:accept-flow",
